{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aep:contracts:v1",
  "title": "AEP execution plan v1",
  "$ref": "#/$defs/plan",
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"},
    "money": {"type": "integer", "minimum": 0},
    "artifactRef": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "submission": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "idempotency_key", "request", "budget_micro_usd", "timeout_seconds"],
      "properties": {
        "schema_version": {"const": "1"},
        "idempotency_key": {"$ref": "#/$defs/id"},
        "request": {"type": "string", "minLength": 1, "maxLength": 100000},
        "budget_micro_usd": {"$ref": "#/$defs/money"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 32},
        "plan": {"$ref": "#/$defs/plan"},
        "input_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}, "maxItems": 100}
      }
    },
    "retry": {
      "type": "object", "additionalProperties": false,
      "required": ["max_attempts", "initial_backoff_seconds", "max_backoff_seconds"],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
        "initial_backoff_seconds": {"type": "integer", "minimum": 1},
        "max_backoff_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "kind", "handler", "instructions", "depends_on", "input_artifacts", "capabilities", "timeout_seconds", "context_token_limit", "retry"],
      "properties": {
        "task_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["research", "evidence_review", "report_writer", "utility"]},
        "handler": {"$ref": "#/$defs/id"},
        "instructions": {"type": "string", "minLength": 1, "maxLength": 100000},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}, "maxItems": 100},
        "input_artifacts": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/artifactRef"}},
        "capabilities": {"type": "array", "uniqueItems": true, "maxItems": 100, "items": {"$ref": "#/$defs/id"}},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "context_token_limit": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "retry": {"$ref": "#/$defs/retry"}
      }
    },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "plan_id", "revision", "tasks"],
      "properties": {
        "schema_version": {"const": "1"},
        "plan_id": {"$ref": "#/$defs/id"},
        "revision": {"const": 1},
        "tasks": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/task"}}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "statement", "sources"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/id"},
        "statement": {"type": "string", "minLength": 1},
        "sources": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["artifact", "locator"],
          "properties": {"artifact": {"$ref": "#/$defs/artifactRef"}, "locator": {"type": "string", "minLength": 1}}
        }}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["conflicts", "unsupported_claim_ids"],
      "properties": {
        "unsupported_claim_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "conflicts": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["claim_ids", "status", "explanation"],
          "properties": {
            "claim_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
            "status": {"enum": ["resolved", "unresolved"]},
            "explanation": {"type": "string", "minLength": 1}
          }
        }}
      }
    },
    "taskResult": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "task_id", "attempt_id", "artifacts", "findings"],
      "properties": {
        "schema_version": {"const": "1"},
        "task_id": {"$ref": "#/$defs/id"},
        "attempt_id": {"$ref": "#/$defs/id"},
        "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifactRef"}},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "review": {"$ref": "#/$defs/review"}
      }
    }
  }
}
