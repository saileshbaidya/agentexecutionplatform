{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aep:contracts:v1",
  "title": "AEP execution plan v1",
  "$ref": "#/$defs/plan",
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"},
    "money": {"type": "integer", "minimum": 0, "maximum": 9000000000000000},
    "agentConfig": {
      "type": "object", "additionalProperties": false,
      "required": ["backend"],
      "properties": {
        "backend": {"enum": ["recorded", "openai"]},
        "research_branches": {"type": "integer", "minimum": 1, "maximum": 4},
        "max_input_tokens": {"type": "integer", "minimum": 1024, "maximum": 64000},
        "context_byte_limit": {"type": "integer", "minimum": 2048, "maximum": 128000},
        "max_output_tokens": {"type": "integer", "minimum": 512, "maximum": 8192},
        "max_call_cost_micro_usd": {"$ref": "#/$defs/money"}
      }
    },
    "document": {
      "type": "object", "additionalProperties": false,
      "required": ["document_id", "title", "text"],
      "properties": {
        "document_id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "text": {"type": "string", "minLength": 1, "maxLength": 20000}
      }
    },
    "toolCall": {
      "type": "object", "additionalProperties": false,
      "required": ["call_key", "tool", "arguments"],
      "properties": {
        "call_key": {"$ref": "#/$defs/id"},
        "tool": {"enum": ["text.stats", "python.run"]},
        "arguments": {"type": "object", "maxProperties": 2}
      }
    },
    "paidCall": {
      "type": "object", "additionalProperties": false,
      "required": ["call_key", "provider", "input", "max_input_tokens", "max_output_tokens", "output_tokens", "max_cost_micro_usd"],
      "properties": {
        "call_key": {"$ref": "#/$defs/id"},
        "provider": {"const": "fake-v1"},
        "input": {"type": "string", "maxLength": 100000},
        "max_input_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "max_output_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "output_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "max_cost_micro_usd": {"$ref": "#/$defs/money"},
        "mode": {"enum": ["success", "known_failure", "timeout_after_accept", "timeout_before_accept"]},
        "reconcile_delay_seconds": {"type": "integer", "minimum": 0, "maximum": 3600}
      }
    },
    "adjustment": {
      "type": "object", "additionalProperties": false,
      "required": ["adjustment_key", "delta_micro_usd", "reason"],
      "properties": {
        "adjustment_key": {"$ref": "#/$defs/id"},
        "delta_micro_usd": {"type": "integer", "minimum": -9000000000000000, "maximum": 9000000000000000},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "artifactRef": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "submission": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "idempotency_key", "request", "budget_micro_usd", "timeout_seconds"],
      "properties": {
        "schema_version": {"const": "1"},
        "idempotency_key": {"$ref": "#/$defs/id"},
        "request": {"type": "string", "minLength": 1, "maxLength": 100000},
        "budget_micro_usd": {"$ref": "#/$defs/money"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 32},
        "agent": {"$ref": "#/$defs/agentConfig"},
        "documents": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/document"}},
        "plan": {"$ref": "#/$defs/plan"},
        "input_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}, "maxItems": 100}
      }
    },
    "retry": {
      "type": "object", "additionalProperties": false,
      "required": ["max_attempts", "initial_backoff_seconds", "max_backoff_seconds"],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
        "initial_backoff_seconds": {"type": "integer", "minimum": 1},
        "max_backoff_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "kind", "handler", "instructions", "depends_on", "input_artifacts", "capabilities", "timeout_seconds", "context_token_limit", "retry"],
      "properties": {
        "task_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["research", "evidence_review", "report_writer", "utility"]},
        "handler": {"$ref": "#/$defs/id"},
        "instructions": {"type": "string", "minLength": 1, "maxLength": 100000},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}, "maxItems": 100},
        "input_artifacts": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/artifactRef"}},
        "capabilities": {"type": "array", "uniqueItems": true, "maxItems": 100, "items": {"$ref": "#/$defs/id"}},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "context_token_limit": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "paid_call": {"$ref": "#/$defs/paidCall"},
        "tool_call": {"$ref": "#/$defs/toolCall"},
        "agent_profile": {"type": "object"},
        "retry": {"$ref": "#/$defs/retry"}
      }
    },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "plan_id", "revision", "tasks"],
      "properties": {
        "schema_version": {"const": "1"},
        "plan_id": {"$ref": "#/$defs/id"},
        "revision": {"const": 1},
        "tasks": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/task"}}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "statement", "sources"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/id"},
        "statement": {"type": "string", "minLength": 1},
        "sources": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["artifact", "locator"],
          "properties": {"artifact": {"$ref": "#/$defs/artifactRef"}, "locator": {"type": "string", "minLength": 1}, "quote": {"type": "string", "minLength": 1}}
        }}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["conflicts", "unsupported_claim_ids"],
      "properties": {
        "unsupported_claim_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "conflicts": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["claim_ids", "status", "explanation"],
          "properties": {
            "claim_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
            "status": {"enum": ["resolved", "unresolved"]},
            "explanation": {"type": "string", "minLength": 1}
          }
        }}
      }
    },
    "taskResult": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "task_id", "attempt_id", "artifacts", "findings"],
      "properties": {
        "schema_version": {"const": "1"},
        "task_id": {"$ref": "#/$defs/id"},
        "attempt_id": {"$ref": "#/$defs/id"},
        "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifactRef"}},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "review": {"$ref": "#/$defs/review"},
        "agent_output": {"type": "object"},
        "tool_output": {"type": "object"}
      }
    }
  }
}
