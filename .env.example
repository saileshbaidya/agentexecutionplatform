DATABASE_URL=postgresql://aep:aep_local_only@127.0.0.1:5432/aep
ARTIFACT_ROOT=./artifacts
# Single-owner development key. Replace before exposing the API beyond localhost.
AEP_API_KEY=local-development-only
AEP_LEASE_SECONDS=15
AEP_POLL_SECONDS=1
# Increase to 30 for the worker-kill demonstration.
AEP_FAKE_DELAY_SECONDS=0
# Default and maximum per-run concurrency for newly submitted runs (1..32).
AEP_RUN_CONCURRENCY_LIMIT=4
# Standalone workers can maintain state; Compose workers use its dedicated scheduler.
AEP_WORKER_MAINTENANCE=true
