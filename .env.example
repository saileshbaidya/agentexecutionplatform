DATABASE_URL=postgresql://aep:aep_local_only@127.0.0.1:5432/aep
ARTIFACT_ROOT=./artifacts
# Single-owner development key. Replace before exposing the API beyond localhost.
AEP_API_KEY=local-development-only
AEP_LEASE_SECONDS=15
AEP_POLL_SECONDS=1
# Increase to 30 for the worker-kill demonstration.
AEP_FAKE_DELAY_SECONDS=0
# Default and maximum per-run concurrency for newly submitted runs (1..32).
AEP_RUN_CONCURRENCY_LIMIT=4
# Standalone workers can maintain state; Compose workers use its dedicated scheduler.
AEP_WORKER_MAINTENANCE=true
# Standalone maintenance includes accounting; Compose uses a separate reconciler.
AEP_INLINE_RECONCILIATION=true
# Real generation is opt-in. Set a supported pinned model and your approved USD
# rate card (integer micro-USD PER MILLION tokens). No model or price is guessed.
AEP_ENABLE_OPENAI=false
OPENAI_API_KEY=
AEP_OPENAI_MODEL=
AEP_MODEL_PRICE_VERSION=
AEP_MODEL_INPUT_RATE=0
# Leave empty to conservatively use the input rate; use an explicit 0 only if free.
AEP_MODEL_CACHED_INPUT_RATE=
AEP_MODEL_OUTPUT_RATE=0
AEP_MODEL_HTTP_TIMEOUT=30
